# PUBLIC: URL deployment Invitation, bukan website portfolio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Gunakan publishable key; ANON_KEY legacy juga didukung.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Kosongkan bila belum ingin menampilkan WhatsApp. Format 628xxx, tanpa +.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
# false = hanya katalog, demo, akun, dan draft. Tidak menerima permintaan pesanan.
# true = permintaan pengerjaan manual; BUKAN pembayaran/penerbitan otomatis.
ENABLE_ORDER_REQUESTS=false

# Tahap 4: feature gates deployment (database gates remain authoritative).
ENABLE_CHECKOUT=false
ENABLE_PUBLIC_INVITATIONS=false
# SERVER ONLY: required for ALL public invitations/RSVP/photo routes in stage 7, never NEXT_PUBLIC_.
# Use the secret key of the SAME Supabase project; never commit a real key.
SUPABASE_SECRET_KEY=

# Tahap 5: server gate for public RSVP. Also enable database platform + per-invitation settings.
ENABLE_RSVP=false

# Tahap 7: SERVER ONLY. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_HMAC_KEY=

# v1.9: general wishes, independent of RSVP. Also enable admin + per-invitation gates.
ENABLE_PUBLIC_WISHES=false
