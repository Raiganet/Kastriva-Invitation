<%- include('partials/header') %>

<section class="pt-24 pb-20">
  <div class="max-w-2xl mx-auto px-4">
    <% if (page === 'order-success') { %>
      <div class="text-center py-20">
        <div class="text-6xl mb-6">🎉</div>
        <h1 class="font-serif text-3xl font-bold mb-4">Pesanan Berhasil!</h1>
        <p class="text-gray-500 mb-2">Kode pesanan Anda:</p>
        <div class="text-2xl font-bold text-rose-600 bg-rose-50 inline-block px-6 py-3 rounded-xl mb-6"><%= orderCode %></div>
        <p class="text-gray-500 text-sm mb-8">Tim kami akan menghubungi Anda melalui WhatsApp/Email dalam 1x24 jam untuk proses selanjutnya.</p>
        <a href="/" class="bg-rose-600 text-white px-8 py-3 rounded-full font-semibold hover:bg-rose-700 transition">Kembali ke Beranda</a>
      </div>
    <% } else { %>
      <a href="/demo/<%= template.slug %>" class="text-rose-600 hover:underline text-sm">← Kembali ke Demo</a>
      <h1 class="font-serif text-3xl font-bold mt-4 mb-2">Pesan Template</h1>
      <p class="text-gray-500 mb-8"><%= template.name %> — Rp <%= template.price.toLocaleString('id-ID') %></p>

      <form action="/order/submit" method="POST" class="bg-white rounded-2xl p-6 md:p-8 shadow-lg space-y-5">
        <input type="hidden" name="template_id" value="<%= template.id %>">
        
        <div>
          <label class="block text-sm font-medium mb-1">Jenis Acara *</label>
          <select name="event_type" required class="w-full border rounded-xl px-4 py-3">
            <option value="pernikahan">Pernikahan</option>
            <option value="ulang-tahun">Ulang Tahun</option>
            <option value="aqiqah">Aqiqah</option>
            <option value="acara-kantor">Acara Kantor</option>
            <option value="lainnya">Lainnya</option>
          </select>
        </div>

        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium mb-1">Nama Mempelai Pria / Yang Punya Acara</label>
            <input type="text" name="groom_name" class="w-full border rounded-xl px-4 py-3" placeholder="Ahmad">
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Nama Mempelai Wanita</label>
            <input type="text" name="bride_name" class="w-full border rounded-xl px-4 py-3" placeholder="Siti">
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium mb-1">Tanggal Acara *</label>
          <input type="date" name="event_date" required class="w-full border rounded-xl px-4 py-3">
        </div>

        <div>
          <label class="block text-sm font-medium mb-1">Lokasi Acara *</label>
          <input type="text" name="event_location" required class="w-full border rounded-xl px-4 py-3" placeholder="Gedung Serbaguna, Jakarta">
        </div>

        <hr>
        <h3 class="font-semibold">Data Pemesan</h3>

        <div>
          <label class="block text-sm font-medium mb-1">Nama Lengkap *</label>
          <input type="text" name="customer_name" required class="w-full border rounded-xl px-4 py-3">
        </div>
        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium mb-1">Email *</label>
            <input type="email" name="customer_email" required class="w-full border rounded-xl px-4 py-3">
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">No. WhatsApp *</label>
            <input type="tel" name="customer_phone" required class="w-full border rounded-xl px-4 py-3" placeholder="08123456789">
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium mb-1">Pesan Tambahan</label>
          <textarea name="custom_message" rows="3" class="w-full border rounded-xl px-4 py-3" placeholder="Tema warna, request khusus, dll..."></textarea>
        </div>

        <div class="bg-rose-50 rounded-xl p-4 flex items-center justify-between">
          <span class="font-medium">Total Pembayaran</span>
          <span class="text-2xl font-bold text-rose-600">Rp <%= template.price.toLocaleString('id-ID') %></span>
        </div>

        <button type="submit" class="w-full bg-rose-600 text-white py-4 rounded-xl font-semibold text-lg hover:bg-rose-700 transition">
          Konfirmasi Pesanan
        </button>
        <p class="text-xs text-gray-400 text-center">Dengan memesan, Anda menyetujui syarat & ketentuan kami.</p>
      </form>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
