<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Admin — UndanganKu</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen">
  <nav class="bg-gray-900 text-white px-6 py-4 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span class="text-xl">💌</span>
      <span class="font-bold">UndanganKu Admin</span>
    </div>
    <a href="/admin/logout" class="text-sm text-gray-400 hover:text-white">Logout</a>
  </nav>

  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-8">
      <div class="bg-white rounded-xl p-5 shadow-sm">
        <div class="text-2xl font-bold text-rose-600"><%= stats.totalOrders %></div>
        <div class="text-xs text-gray-500">Total Pesanan</div>
      </div>
      <div class="bg-white rounded-xl p-5 shadow-sm">
        <div class="text-2xl font-bold text-yellow-600"><%= stats.pendingOrders %></div>
        <div class="text-xs text-gray-500">Pending</div>
      </div>
      <div class="bg-white rounded-xl p-5 shadow-sm">
        <div class="text-2xl font-bold text-green-600"><%= stats.completedOrders %></div>
        <div class="text-xs text-gray-500">Selesai</div>
      </div>
      <div class="bg-white rounded-xl p-5 shadow-sm">
        <div class="text-2xl font-bold text-blue-600">Rp <%= stats.totalRevenue.toLocaleString('id-ID') %></div>
        <div class="text-xs text-gray-500">Revenue</div>
      </div>
      <div class="bg-white rounded-xl p-5 shadow-sm">
        <div class="text-2xl font-bold text-purple-600"><%= stats.totalTemplates %></div>
        <div class="text-xs text-gray-500">Template</div>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b">
        <h2 class="font-bold text-lg">Pesanan Terbaru</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-3 text-left">Kode</th>
              <th class="px-4 py-3 text-left">Pelanggan</th>
              <th class="px-4 py-3 text-left">Template</th>
              <th class="px-4 py-3 text-left">Tanggal</th>
              <th class="px-4 py-3 text-left">Total</th>
              <th class="px-4 py-3 text-left">Status</th>
              <th class="px-4 py-3 text-left">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% recentOrders.forEach(o => { %>
              <tr class="border-t hover:bg-gray-50">
                <td class="px-4 py-3 font-mono text-xs"><%= o.order_code %></td>
                <td class="px-4 py-3">
                  <div class="font-medium"><%= o.customer_name %></div>
                  <div class="text-xs text-gray-400"><%= o.customer_email %></div>
                </td>
                <td class="px-4 py-3"><%= o.template_name || '-' %></td>
                <td class="px-4 py-3"><%= o.event_date %></td>
                <td class="px-4 py-3 font-semibold">Rp <%= o.total_price.toLocaleString('id-ID') %></td>
                <td class="px-4 py-3">
                  <span class="px-2 py-1 rounded-full text-xs font-medium
                    <%= o.status === 'pending' ? 'bg-yellow-100 text-yellow-700' : '' %>
                    <%= o.status === 'processing' ? 'bg-blue-100 text-blue-700' : '' %>
                    <%= o.status === 'completed' ? 'bg-green-100 text-green-700' : '' %>
                    <%= o.status === 'cancelled' ? 'bg-red-100 text-red-700' : '' %>
                  "><%= o.status %></span>
                </td>
                <td class="px-4 py-3">
                  <form method="POST" action="/admin/order/<%= o.id %>/status" class="flex gap-1">
                    <select name="status" class="border rounded px-2 py-1 text-xs">
                      <option value="pending" <%= o.status === 'pending' ? 'selected' : '' %>>Pending</option>
                      <option value="processing" <%= o.status === 'processing' ? 'selected' : '' %>>Proses</option>
                      <option value="completed" <%= o.status === 'completed' ? 'selected' : '' %>>Selesai</option>
                      <option value="cancelled" <%= o.status === 'cancelled' ? 'selected' : '' %>>Batal</option>
                    </select>
                    <button type="submit" class="bg-rose-600 text-white px-2 py-1 rounded text-xs">✓</button>
                  </form>
                </td>
              </tr>
            <% }) %>
            <% if (recentOrders.length === 0) { %>
              <tr><td colspan="7" class="px-4 py-8 text-center text-gray-400">Belum ada pesanan</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</body>
</html>
