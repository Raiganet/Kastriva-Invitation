<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>UndanganKu — Jasa Undangan Digital Premium</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            serif: ['Playfair Display', 'serif'],
            sans: ['Inter', 'sans-serif'],
          }
        }
      }
    }
  </script>
</head>
<body class="font-sans bg-gray-50 text-gray-800">
  <% if (page !== 'demo' && page !== 'admin-login' && !page.startsWith('preview')) { %>
  <nav class="bg-white/90 backdrop-blur-md shadow-sm fixed w-full z-50 top-0">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between h-16 items-center">
        <a href="/" class="flex items-center gap-2">
          <span class="text-2xl">💌</span>
          <span class="font-serif text-xl font-bold text-rose-600">UndanganKu</span>
        </a>
        <div class="hidden md:flex items-center gap-8">
          <a href="/" class="text-sm font-medium hover:text-rose-600 transition <%= currentPath === '/' ? 'text-rose-600' : '' %>">Beranda</a>
          <a href="/templates" class="text-sm font-medium hover:text-rose-600 transition <%= currentPath === '/templates' ? 'text-rose-600' : '' %>">Template</a>
          <a href="/pricing" class="text-sm font-medium hover:text-rose-600 transition <%= currentPath === '/pricing' ? 'text-rose-600' : '' %>">Harga</a>
          <a href="/templates" class="bg-rose-600 text-white px-5 py-2 rounded-full text-sm font-semibold hover:bg-rose-700 transition shadow-lg shadow-rose-200">Pesan Sekarang</a>
        </div>
        <button id="mobileMenuBtn" class="md:hidden p-2">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </div>
    <div id="mobileMenu" class="hidden md:hidden bg-white border-t px-4 pb-4">
      <a href="/" class="block py-2 text-sm">Beranda</a>
      <a href="/templates" class="block py-2 text-sm">Template</a>
      <a href="/pricing" class="block py-2 text-sm">Harga</a>
      <a href="/templates" class="block mt-2 bg-rose-600 text-white text-center py-2 rounded-full text-sm font-semibold">Pesan Sekarang</a>
    </div>
  </nav>
  <% } %>
