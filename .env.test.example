KI_TEST_EMAIL_A=
KI_TEST_PASSWORD_A=
KI_TEST_EMAIL_B=
KI_TEST_PASSWORD_B=
# The exact project ref before .supabase.co, to avoid accidentally targeting another project.
KI_TEST_PROJECT_REF=
KI_TEST_ALLOW_WRITES=false
