# OPTIONAL integration test — dedicated STAGING Supabase project only.
# Copy to .env.test.local (ignored by Git). Never paste real credentials into chat.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
